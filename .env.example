# ========================================================
# GeoVacantes - Plantilla de Configuración (.env.example)
# Copia este archivo como .env y ajusta los valores en tu servidor:
# cp .env.example .env
# ========================================================

# Configuración del Servidor Web
PORT=8000
HOST=0.0.0.0

# Base de Datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=movilidad_docente

# Credenciales del Administrador para el Panel Web
ADMIN_USER=tu_correo_admin@ejemplo.com
ADMIN_PASSWORD=tu_contraseña_segura_aqui
ADMIN_TOKEN_SECRET=genera_un_token_secreto_largo_y_aleatorio

# API de Ruteo Vial OSRM (Carlos Aguilar)
ROUTING_API_URL=https://rutas.carlosaguilar.mx
ROUTING_API_KEY=tu_api_key_opcional_aqui
